<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/glass_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="睡眠守护"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/glass_on_surface"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="到点自动收走手机，只留下必要的联系"
            android:textSize="14sp"
            android:textColor="@color/glass_secondary_text"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvNightStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="睡眠守护未启用"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/glass_on_surface"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvNightDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="先设好时段与微信规则，再打开开关"
                    android:textSize="14sp"
                    android:textColor="@color/glass_secondary_text" />

                <TextView
                    android:id="@+id/tvNightHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/glass_destructive"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchNight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="每天自动开启守护"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/glass_on_surface"
                    android:paddingBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="守护时段（跨天自动处理）"
                    android:textSize="14sp"
                    android:textColor="@color/glass_secondary_text"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSetStart"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="开始 23:00"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSetEnd"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="结束 07:00"
                        android:layout_marginStart="6dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="夜间仍然可用"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/glass_on_surface"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="电话、来电界面、短信、联系人、闹钟、桌面会自动放行，无需手动添加。"
                    android:textSize="13sp"
                    android:textColor="@color/glass_secondary_text"
                    android:layout_marginBottom="12dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchWechatChatOnly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="微信：仅聊天（推荐）"
                    android:textSize="15sp"
                    android:textColor="@color/glass_on_surface"
                    android:checked="true"
                    android:paddingBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开启：只留聊天，视频号、朋友圈、小程序、直播、公众号、视频通话一律拦下。关闭：夜间完全禁用微信。"
                    android:textSize="13sp"
                    android:textColor="@color/glass_secondary_text"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditWhitelist"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="额外允许的应用" />

                <TextView
                    android:id="@+id/tvWhitelistSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前：无额外应用"
                    android:textSize="13sp"
                    android:textColor="@color/glass_secondary_text"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="别让半夜的自己关掉它"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/glass_on_surface"
                    android:layout_marginBottom="6dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchStrict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="夜间锁定设置（推荐）"
                    android:textSize="15sp"
                    android:textColor="@color/glass_on_surface"
                    android:checked="true"
                    android:paddingBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="守护时段内不能关闭守护、改时间、改白名单，也不能设定或修改任何解锁密码。系统设置与卸载入口同样会被拦下。"
                    android:textSize="13sp"
                    android:textColor="@color/glass_secondary_text" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="两种解锁方式"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/glass_on_surface"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="密码只能在白天设定，且只存加盐哈希，界面不会显示明文。夜里唯一能按的按钮是「输入密码解锁」。"
                    android:textSize="13sp"
                    android:textColor="@color/glass_secondary_text"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/tvMasterState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="① 纸条密码：尚未设定"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/glass_on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="① 30 位纸条密码（一次性）：App 随机生成、只显示一次，抄在纸上放到另一个房间。夜里用一次立即作废，白天必须重新生成新纸条。"
                    android:textSize="13sp"
                    android:textColor="@color/glass_secondary_text"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenerateMaster"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="生成新的 30 位纸条密码" />

                <TextView
                    android:id="@+id/tvEmergencyState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="② 紧急密码：尚未设定"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/glass_on_surface"
                    android:layout_marginTop="18dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="② 6 位紧急密码（亲友保管）：白天请亲友输入并记住，机主看不到。可重复使用，但每次解锁都会记录次数与时间。"
                    android:textSize="13sp"
                    android:textColor="@color/glass_secondary_text"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetEmergency"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="设定 / 重设 6 位紧急密码（交给亲友）" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnlockDuration"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="解锁时长：30 分钟（点击切换）"
                    android:layout_marginTop="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnlock"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="夜间解锁（输入密码）" />

                <TextView
                    android:id="@+id/tvLockHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/glass_secondary_text"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckPermissions"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="检查必要权限"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>
