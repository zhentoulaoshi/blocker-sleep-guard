@rem
@rem Gradle wrapper start script (minimal, Windows).
@rem gradle-wrapper.jar is generated by Android Studio or by
@rem `gradle wrapper --gradle-version 8.6`.
@rem
@if "%DEBUG%" == "" @echo off
setlocal

set DIRNAME=%~dp0
set APP_HOME=%DIRNAME%
set CLASSPATH=%APP_HOME%gradle\wrapper\gradle-wrapper.jar

if not exist "%CLASSPATH%" goto missingJar

if defined JAVA_HOME (
    set JAVACMD="%JAVA_HOME%\bin\java.exe"
) else (
    set JAVACMD=java.exe
)

%JAVACMD% %DEFAULT_JVM_OPTS% %JAVA_OPTS% %GRADLE_OPTS% -classpath "%CLASSPATH%" org.gradle.wrapper.GradleWrapperMain %*
exit /b %ERRORLEVEL%

:missingJar
echo ERROR: gradle\wrapper\gradle-wrapper.jar is missing. 1>&2
echo Run: gradle wrapper --gradle-version 8.6 --distribution-type bin 1>&2
echo Or open the project in Android Studio, or use the GitHub Actions workflow. 1>&2
exit /b 1
